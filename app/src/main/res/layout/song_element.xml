        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/song_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:padding="5dp"
            android:layout_marginHorizontal="6dp"
            android:layout_marginVertical="@dimen/s"
            android:background="@drawable/gradient_bg"
            android:backgroundTintMode="multiply"
            android:backgroundTint="#5DFD00E8"
            android:foreground="@drawable/glow_bg"
            android:foregroundTint="#44B100FD"
            android:foregroundTintMode="multiply"
            >

            <ImageView
                android:id="@+id/song_icon_cont"
                android:layout_width="60dp"
                android:layout_height="60dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                android:background="@drawable/circle"
                android:backgroundTint="#87EA00FF"
                android:contentDescription="@string/app_name">
            </ImageView>

            <ImageView
                android:id="@+id/song_icon"
                android:layout_width="30dp"
                android:layout_height="30dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="@id/song_icon_cont"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:background="@drawable/music_filled"
                android:backgroundTint="#FFFFFF"
                android:contentDescription="@string/app_name">
            </ImageView>

<!--            <ImageView-->
<!--                android:id="@+id/song_icon"-->
<!--                android:layout_width="30dp"-->
<!--                android:layout_height="30dp"-->
<!--                app:layout_constraintStart_toStartOf="parent"-->
<!--                app:layout_constraintEnd_toEndOf="@id/song_icon_cont"-->
<!--                app:layout_constraintTop_toTopOf="parent"-->
<!--                app:layout_constraintBottom_toBottomOf="parent"-->
<!--                android:background="@drawable/music"-->
<!--                android:backgroundTint="#a3ef00"-->
<!--                android:contentDescription="@string/app_name">-->
<!--            </ImageView>-->

            <TextView
                android:id="@+id/title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:padding="0dp"
                app:layout_constraintStart_toEndOf="@id/song_icon_cont"
                app:layout_constraintEnd_toStartOf="@id/color_change"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintVertical_bias="0.3"
                android:text="FUCK YOU"
                android:textColor="#f255cc"
                android:textSize="20dp"
                android:fontFamily="@font/retro"
                app:layout_constraintVertical_weight="10.0"
                android:maxLines="1"
                android:scrollbars="horizontal"
                android:ellipsize="end"
                android:textAlignment="textStart"
                android:paddingVertical="9dp"
                android:layout_marginRight="50dp"
                android:layout_marginLeft="5dp"
>
<!--                android:fontFamily="@font/retro"-->


            </TextView>

            <TextView
                android:id="@+id/artist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="0dp"
                android:text="DEATH"
                android:textColor="#9CF255CC"
                android:textSize="@dimen/m"
                android:fontFamily="@font/retro"
                android:maxLines="1"
                app:layout_constraintStart_toEndOf="@id/song_icon_cont"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintVertical_bias="0.7"
                android:layout_marginLeft="5dp"
                >

            </TextView>

            <ImageView
                android:id="@+id/playlist_add"
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/name_change"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:layout_marginRight="10dp"
                android:src="@drawable/playlist_add"
                app:tint="#FF9800"
                android:scaleY="0.8"
                android:scaleX="0.8"
                android:visibility="gone">
            </ImageView>

            <ImageView
                android:id="@+id/name_change"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                app:layout_constraintEnd_toStartOf="@id/playlist_add"
                app:layout_constraintStart_toEndOf="@id/color_change"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:layout_marginRight="0dp"

                android:src="@drawable/name_change"
                app:tint="#FF9800"
                android:visibility="gone">
            </ImageView>

            <ImageView
                android:id="@+id/color_change"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                app:layout_constraintEnd_toStartOf="@id/name_change"
                app:layout_constraintStart_toEndOf="@id/title"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:layout_marginRight="5dp"

                android:src="@drawable/color_change"
                app:tint="#FF9800"
                android:visibility="gone">
            </ImageView>



        </androidx.constraintlayout.widget.ConstraintLayout>

<!--    </androidx.cardview.widget.CardView>-->

</androidx.constraintlayout.widget.ConstraintLayout>