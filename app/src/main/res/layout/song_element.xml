<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:elevation="10dp">

    <androidx.cardview.widget.CardView
        android:id="@+id/song_card"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:theme="@style/Theme.MaterialComponents.DayNight"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginVertical="@dimen/s"
        android:layout_marginHorizontal="6dp"
        app:cardBackgroundColor="#00000000">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/songelement">

            <ImageView
                android:id="@+id/side_line"
                android:layout_width="15dp"
                android:layout_height="60dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                android:background="@drawable/song_color"
                android:backgroundTint="#a3ef00"
                android:contentDescription="@string/app_name">
            </ImageView>

            <TextView
                android:id="@+id/title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="FUCK YOU"
                android:textColor="#f255cc"
                android:textSize="20dp"
                android:fontFamily="@font/retro"
                android:maxLines="1"
                android:scrollbars="horizontal"
                android:ellipsize="end"
                app:layout_constraintStart_toEndOf="@id/side_line"
                app:layout_constraintEnd_toStartOf="@id/color_change"
                app:layout_constraintTop_toTopOf="parent"
                android:textAlignment="textStart"
                android:paddingVertical="9dp"
                android:layout_marginRight="100px"
>


            </TextView>

            <TextView
                android:id="@+id/artist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DEATH"
                android:textColor="#140a0d"
                android:textSize="@dimen/sm"
                android:fontFamily="@font/retro"
                android:maxLines="1"
                app:layout_constraintStart_toEndOf="@id/side_line"
                app:layout_constraintBottom_toBottomOf="parent"
                android:padding="10dp">

            </TextView>

            <ImageView
                android:id="@+id/playlist_add"
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/name_change"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:layout_marginRight="35dp"
                android:src="@drawable/playlist_add"
                app:tint="#a3ef00"
                android:scaleY="0.8"
                android:scaleX="0.8"
                android:visibility="gone">
            </ImageView>

            <ImageView
                android:id="@+id/name_change"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                app:layout_constraintEnd_toStartOf="@id/playlist_add"
                app:layout_constraintStart_toEndOf="@id/color_change"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:layout_marginRight="0dp"

                android:src="@drawable/name_change"
                app:tint="#a3ef00"
                android:visibility="gone">
            </ImageView>

            <ImageView
                android:id="@+id/color_change"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                app:layout_constraintEnd_toStartOf="@id/name_change"
                app:layout_constraintStart_toEndOf="@id/title"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:layout_marginRight="5dp"

                android:src="@drawable/color_change"
                app:tint="#a3ef00"
                android:visibility="gone">
            </ImageView>



        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>