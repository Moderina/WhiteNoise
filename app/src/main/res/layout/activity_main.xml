    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/appbar"
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:padding="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
    >

        <!-- Toolbar Section -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/toolbar_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:elevation="20dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- Menu Button -->
            <ImageButton
                android:id="@+id/menu_btn"
                android:layout_width="55dp"
                android:layout_height="55dp"
                android:background="?attr/selectableItemBackgroundBorderless"                android:src="@drawable/menu"
                android:contentDescription="Menu"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:tint="#f255cc" />

            <!-- Title -->
            <TextView
                android:id="@+id/title_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Song List"
                android:textColor="#2196F3"
                android:textSize="30sp"
                android:textStyle="bold"
                android:fontFamily="@font/retro"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@id/menu_btn"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.9" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Static SearchView Below -->
        <androidx.appcompat.widget.SearchView
            android:id="@+id/search_view"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:queryHint="Search songs..."
            android:background="@drawable/gradient_bg"

            app:layout_constraintTop_toBottomOf="@id/toolbar_container"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:iconifiedByDefault="false"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"/>

    </androidx.constraintlayout.widget.ConstraintLayout>



    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/mini_player"
        android:layout_width="match_parent"
        android:layout_height="110dp"
        android:animateLayoutChanges="true"
        android:background="@drawable/glow_bg"
        android:backgroundTintMode="screen"
        android:backgroundTint="#4CF000FF"
        android:elevation="100dp"
        android:outlineAmbientShadowColor="#FF0000"
        android:paddingHorizontal="12dp"
        android:paddingTop="25dp"
        android:visibility="visible"
        app:layout_constraintBottom_toBottomOf="parent">

        <ImageView
            android:id="@+id/mini_song_icon"
            android:layout_width="50dp"
            android:layout_height="50dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

        </ImageView>

        <TextView
            android:id="@+id/mini_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_marginTop="0dp"
            android:ellipsize="marquee"
            android:fontFamily="@font/retro"
            android:singleLine="true"
            android:text="song title"
            android:textColor="#FFFFFF"
            android:textSize="24dp"
            app:layout_constraintStart_toEndOf="@id/mini_song_icon"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/mini_artist"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="13dp"
            android:layout_marginTop="@dimen/xs"
            android:ellipsize="marquee"
            android:fontFamily="@font/retro"
            android:singleLine="true"
            android:text="song title"
            android:textColor="#FFFFFF"
            android:textSize="14dp"
            app:layout_constraintStart_toEndOf="@id/mini_song_icon"
            app:layout_constraintTop_toBottomOf="@id/mini_title" />

        <ImageView
            android:id="@+id/play_pause_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="-8dp"
            android:scaleX="0.6"
            android:scaleY="0.6"
            android:src="@drawable/play_icon"
            app:layout_constraintBottom_toTopOf="@id/progress_bar"
            app:layout_constraintEnd_toEndOf="parent"
            app:tint="#f255cc" />

        <ProgressBar
            android:id="@+id/progress_bar"
            style="@style/Widget.AppCompat.ProgressBar.Horizontal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:elevation="100dp"
            android:max="100"
            android:outlineAmbientShadowColor="#FFFFFF"
            android:outlineSpotShadowColor="@color/white"
            android:paddingLeft="16dp"
            android:progress="70"
            android:progressBackgroundTint="#912196F3"
            android:progressTint="#2196F3"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/mini_song_icon"
            app:layout_constraintTop_toBottomOf="@id/mini_artist">

        </ProgressBar>


    </androidx.constraintlayout.widget.ConstraintLayout>

    <FrameLayout
        android:id="@+id/FragmentLayout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/mini_player"
        app:layout_constraintTop_toBottomOf="@id/appbar">

    </FrameLayout>

    <include layout="@layout/activity_music_player" />

    <include layout="@layout/activity_yt_player" />

</androidx.constraintlayout.widget.ConstraintLayout>